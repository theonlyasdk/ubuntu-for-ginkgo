# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly enforce LF for shell scripts and system configs
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.patch text eol=lf
*.py text eol=lf
*.dts text eol=lf
*.dtsi text eol=lf
*.c text eol=lf
*.h text eol=lf

# Binary files
*.bin binary
*.tlv binary
*.img binary
*.gz binary
*.dtb binary
